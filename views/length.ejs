<h1 class="text-2xl font-bold mb-4 text-center">Conversor de Longitud</h1>

<form method="POST" class="space-y-4">
  <input
    type="number"
    name="value"
    required
    step="any"
    placeholder="Valor"
    class="w-full px-4 py-2 border border-gray-300 rounded"
  />

  <div class="flex justify-between items-center gap-4">
    <select name="from" class="w-full px-4 py-2 border border-gray-300 rounded">
      <option value="mm">Milímetro</option>
      <option value="cm">Centímetro</option>
      <option value="m">Metro</option>
      <option value="km">Kilómetro</option>
      <option value="in">Pulgada</option>
      <option value="ft">Pie</option>
      <option value="yd">Yarda</option>
      <option value="mi">Milla</option>
    </select>

    <span class="text-gray-500">→</span>

    <select name="to" class="w-full px-4 py-2 border border-gray-300 rounded">
      <option value="mm">Milímetro</option>
      <option value="cm">Centímetro</option>
      <option value="m">Metro</option>
      <option value="km">Kilómetro</option>
      <option value="in">Pulgada</option>
      <option value="ft">Pie</option>
      <option value="yd">Yarda</option>
      <option value="mi">Milla</option>
    </select>
  </div>

  <button
    type="submit"
    class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700"
  >
    Convertir
  </button>
</form>

<% if (result !== null) { %>
<div
  class="mt-6 p-4 bg-green-100 text-green-800 rounded text-center font-medium"
>
  Resultado: <%= result %>
</div>
<% } %>
